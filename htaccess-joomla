# -------------------------------------------------------------------------
# 1. IP-ZUGRIFFSBESCHRÄNKUNG (Apache 2.4+)
# -------------------------------------------------------------------------
<RequireAll>
    # Grundsätzlich jeden Zugriff verweigern
    Require all denied
    
    # Eigene Admin/Test-IPs freigeben (IPv4 und/oder IPv6)
    Require ip 123.45.67.89
    # Require ip 2001:db8::1
</RequireAll>

# -------------------------------------------------------------------------
# 2. JOOMLA! SEF / ROUTING REWRITE ENGINE
# -------------------------------------------------------------------------
<IfModule mod_rewrite.c>
RewriteEngine On

# Basis-Pfad (falls Joomla in einem Unterordner liegt, z. B. RewriteBase /joomla/)
RewriteBase /

# Blockieren bekannter Angriffsmuster auf Joomla-Kern-Dateien
RewriteCond %{QUERY_STRING} (eval\(|base64_encode|GLOBALS|REQUEST) [NC,OR]
RewriteCond %{QUERY_STRING} (mosConfig_[a-zA-Z_]{1,21}(=|\%3D)) [NC]
RewriteRule .* - [F]

# Weiterleitung auf index.php für SEF-URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/index\.php
RewriteRule .* index.php [L]
</IfModule>
